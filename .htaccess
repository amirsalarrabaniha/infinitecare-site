# Apache (shared hosting) equivalent of _headers / _redirects (those are read by Cloudflare only).
# The site is plain static files: `git pull` is the whole deployment. Every block is wrapped in <IfModule>, so a module that
# is not available on the host only disables that block instead of breaking the site.

Options -Indexes
DirectoryIndex index.html

# --- never serve the source / tooling that lives in the same repository ---
<IfModule mod_alias.c>
RedirectMatch 404 /(backend|cf-django|cloudflare|scripts|\.git|\.wrangler|node_modules)(/|$)
</IfModule>
<FilesMatch "(^\.(?!well-known)|\.(py|pyc|sqlite3|toml|sh|md|ya?ml|lock|patch|log)$|^(Procfile|_headers|_redirects|\.htaccess|\.assetsignore|\.gitignore)$)">
 <IfModule mod_authz_core.c>
  Require all denied
 </IfModule>
</FilesMatch>

# --- clean URLs (/services -> services.html, /carbon-hamlasztas -> carbon-hamlasztas.html) and the old site's URLs ---
# Every redirect goes straight to the final https://www URL (one hop, no chains); canonical URLs are clean and never redirect.
<IfModule mod_dir.c>
# /blog is a page (blog.html) and a folder (blog/<post>.html) at the same time: let the rules below decide about the slash
DirectorySlash Off
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
# explicit base: without it some hosts (e.g. Rackhost/ISPConfig) build redirect URLs from the filesystem path
RewriteBase /
# old (pre-2026) pages that have no 1:1 successor
RewriteRule ^home(\.html|/)?$ https://www.infinitecare.hu/ [R=301,L]
RewriteRule ^fooldal(\.html|/)?$ https://www.infinitecare.hu/hu/ [R=301,L]
RewriteRule ^(szolgaltatasaink|araink)(\.html|/)?$ https://www.infinitecare.hu/hu/services [R=301,L]
RewriteRule ^prices(\.html|/)?$ https://www.infinitecare.hu/services [R=301,L]
RewriteRule ^hu/prices(\.html|/)?$ https://www.infinitecare.hu/hu/services [R=301,L]
# one host: infinitecare.hu -> www.infinitecare.hu
RewriteCond %{HTTP_HOST} ^infinitecare\.hu$ [NC]
RewriteRule ^(.*)$ https://www.infinitecare.hu/$1 [R=301,L]
# requests for the .html files themselves -> the clean URL (THE_REQUEST = what the browser asked for, so the internal
# clean -> .html rewrite below never loops back here). Query strings (blog/post.html?p=…) are kept.
RewriteCond %{THE_REQUEST} \s/[^\s?]*\.html[\s?]
RewriteRule ^(.*/)?index\.html$ https://www.infinitecare.hu/$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/[^\s?]*\.html[\s?]
RewriteRule ^(.+)\.html$ https://www.infinitecare.hu/$1 [R=301,L]
# folder with an index page: /hu -> /hu/
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ $1/ [R=301,L]
# folder without an index page: /blog/ -> /blog (blog.html)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}index.html !-f
RewriteRule ^(.+)/$ $1 [R=301,L]
# page with a trailing slash: /carbon-hamlasztas/ -> /carbon-hamlasztas
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ $1 [R=301,L]
# clean URL -> .html file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# --- security headers (same as _headers). connect-src/img-src/media-src include the API: the pages read it at runtime ---
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://infinitecare-api.amyrsalarr.workers.dev; font-src 'self'; media-src 'self' https://infinitecare-api.amyrsalarr.workers.dev; connect-src 'self' https://infinitecare-api.amyrsalarr.workers.dev; frame-src https://www.google.com https://maps.google.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
# css/js are referenced as ...?v=<content hash>
<FilesMatch "\.(css|js|woff2)$">
 Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|mp4|webm)$">
 Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.html$">
 Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>

# --- compression / types ---
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
<IfModule mod_mime.c>
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/javascript .js
</IfModule>
<IfModule mod_expires.c>
ExpiresActive Off
</IfModule>
