# Cloudflare Workers static assets: response headers (https://developers.cloudflare.com/workers/static-assets/headers/)
# Rules are cumulative, so Cache-Control is only set in the specific rules below; HTML keeps the default
# (public, max-age=0, must-revalidate) and is revalidated with an ETag.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://infinitecare-api.amyrsalarr.workers.dev; font-src 'self'; media-src 'self' https://infinitecare-api.amyrsalarr.workers.dev; connect-src 'self' https://infinitecare-api.amyrsalarr.workers.dev; frame-src https://www.google.com https://maps.google.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# css/js are referenced as ...?v=<content hash>, so they can be cached for a year
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# images / media / video keep their file names: 30 days
/assets/images/*
  Cache-Control: public, max-age=2592000
/assets/media/*
  Cache-Control: public, max-age=2592000
/assets/video/*
  Cache-Control: public, max-age=2592000
