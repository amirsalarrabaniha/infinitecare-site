# Copy to backend/.env
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
# Needed for the admin login over HTTPS on your domain
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# Origins allowed to POST to /api/* from another site (GitHub Pages copy)
CORS_ALLOWED_ORIGINS=https://amirsalarrabaniha.github.io
# SQLite file (default backend/db.sqlite3) and uploaded images folder (default backend/media)
# SQLITE_PATH=/var/data/db.sqlite3
# MEDIA_ROOT=/var/data/media
# Contact form rate limit: N submissions per window (seconds) per IP
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=900
# Set True behind Render/Railway/nginx so the real client IP is used
TRUST_X_FORWARDED_FOR=False
# E-mail notifications – leave NOTIFY_EMAIL empty to only store messages
NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Infinite Care website <no-reply@infinitecare.hu>
# Static export: contact API URL baked into the GitHub Pages copy ('' = mailto fallback)
STATIC_EXPORT_API_URL=
STATIC_EXPORT_SITE_URL=https://amirsalarrabaniha.github.io/infinitecare-site/
