{
  "name": "infinitecare-api",
  "main": "src/index.py",
  "account_id": "164584608fafa1395f843df7bb17e1c7",
  "workers_dev": true,
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-10-19",
  // Static files (site css/js/images + Django admin assets) are served directly by Workers assets
  "assets": { "directory": "./staticfiles" },
  "build": { "command": "bash build.sh" },
  "python_modules": {
    "exclude": ["**/*.pyc", "**/__pycache__", "**/*.po", "**/*.css", "**/*.js", "**/*.svg", "**/*.png", "**/*.jpg", "**/*.ico"]
  },
  "observability": { "enabled": true },
  // Database: Django's SQLite runs inside a SQLite-backed Durable Object (django_cf.db.backends.do)
  "durable_objects": { "bindings": [{ "name": "DO_STORAGE", "class_name": "DjangoDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DjangoDO"] }],
  "vars": {
    "ALLOWED_HOSTS": "infinitecare-api.amyrsalarr.workers.dev,localhost,127.0.0.1",
    "CSRF_TRUSTED_ORIGINS": "https://infinitecare-api.amyrsalarr.workers.dev",
    "CORS_ALLOWED_ORIGINS": "https://infinitecare-site.amyrsalarr.workers.dev,https://amirsalarrabaniha.github.io"
  }
  // secrets (wrangler secret put): SECRET_KEY, MGMT_TOKEN
}
